# Optional Google Analytics measurement id. Leave blank until a property exists.
VITE_GOOGLE_ANALYTICS=

# SDEE3 Identity (Clerk) — see docs/specs/03-identity-auth.md
# Shared publishable key (pk_test_… for dev, pk_live_… for prod).
VITE_CLERK_PUBLISHABLE_KEY=
# SDEE3 Identity hub endpoints.
VITE_CLERK_SIGN_IN_URL=https://identity.sdee3.com/sign-in
VITE_CLERK_SIGN_UP_URL=https://identity.sdee3.com/sign-up
# This app's origin, used to build the hub's ?redirect_url= (…/sso-callback).
VITE_APP_ORIGIN=http://localhost:5173
# Convex deployment URL.
VITE_CONVEX_URL=
