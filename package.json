{
  "name": "ezaudit",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n convex,frontend -c blue,magenta \"pnpm convex:dev\" \"pnpm dev:frontend\"",
    "dev:frontend": "pnpm --filter ezaudit-frontend dev",
    "convex:dev": "pnpm --filter ezaudit-backend dev",
    "build": "pnpm --filter ezaudit-frontend build",
    "test": "pnpm --filter ezaudit-frontend test && pnpm --filter ezaudit-backend test",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "convex:deploy": "pnpm --filter ezaudit-backend deploy",
    "convex:deploy:prod": "pnpm --filter ezaudit-backend deploy:prod"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
