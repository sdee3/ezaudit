# Deploy config for scripts/deploy-frontend.sh (gitignored at scripts/.env).
# DISTRIBUTION_ID comes from `../infrastructure/aws/ezaudit` outputs.
BUCKET=ezaudit-sdee3
REGION=us-east-1
DIST_DIR=frontend/dist
DISTRIBUTION_ID=<from the infrastructure apply>

# Production frontend env values written into frontend/.env.production by the
# deploy script. VITE_CLERK_PUBLISHABLE_KEY must be the live Clerk key
# (dashboard step; ezaudit uses the shared SDEE3 Clerk application).
VITE_CONVEX_URL=https://standing-malamute-74.convex.cloud
VITE_APP_ORIGIN=https://ezaudit.sdee3.com
VITE_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
